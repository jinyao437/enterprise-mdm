<?xml version="1.0" encoding="utf-8"?>
<!-- Device Owner 策略声明（激活时授予的能力） -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />
        <expire-password />
        <encrypted-storage />
        <disable-camera />
        <restrict-wallpaper-image />
    </uses-policies>
</device-admin>
